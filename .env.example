# skip-migrator environment template
# Copy to .env and fill in real values.

# Postgres connection string from Supabase project (use the pooler URL for production)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase project URL and service-role key (used by the backend worker)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Optional: JWKS URL for verifying user JWTs (RS256). MVP relies on `sub` claim only.
SUPABASE_JWK_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=<ref>

# Worker concurrency (number of parallel migration jobs)
WORKER_CONCURRENCY=2

# Frontend
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Production
SKIP_MIGRATOR_DOMAIN=skip-migrator.example.com
